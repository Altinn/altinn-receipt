@model AttachmentListViewModel

<ul class="receipt-attachments ds-paragraph" data-size="sm" id="@Model.Id">
    @foreach (ReceiptAttachment attachment in Model.Attachments)
    {
        <li>
            <a class="ds-link" href="@attachment.Url">@attachment.Name</a>
            <span>(@Model.DownloadText)</span>
        </li>
    }
</ul>
